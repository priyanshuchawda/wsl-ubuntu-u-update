# User tools and language environments.
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Zsh history and completions.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE AUTO_CD INTERACTIVE_COMMENTS
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Press Up/Down after typing a command prefix to search matching history.
[[ -n "$terminfo[kcuu1]" ]] && bindkey "$terminfo[kcuu1]" history-beginning-search-backward
[[ -n "$terminfo[kcud1]" ]] && bindkey "$terminfo[kcud1]" history-beginning-search-forward
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# Fish-like inline command suggestions.
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  bindkey '^[[C' autosuggest-accept
  bindkey '^F' autosuggest-accept
fi

# Syntax colors, loaded after other ZLE plugins.
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Fuzzy finder and directory navigation.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[fdfind] )) && alias fd=fdfind
(( $+commands[batcat] )) && alias bat=batcat

# Ubuntu-only updater shortcut.
alias u="$HOME/.local/bin/u-update"
